# --- MongoDB Atlas ---
# Get this from: MongoDB Atlas → your cluster → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.zee69ax.mongodb.net/Life_RPG?retryWrites=true&w=majority"

# --- NextAuth.js v5 ---
# Generate a secret: run `openssl rand -base64 32` in your terminal
AUTH_SECRET="lfwVgQsSgnWMNMKvjA1niEh3Gaa6jxSLcqD6gJ6eOJw"

# The base URL of your application (no trailing slash)
AUTH_URL=http://localhost:3000

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
